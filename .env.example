# ─── Google Wallet: FreeTicket ────────────────────────────────────────────────
# Copy to .env and fill in. .env and secrets/ are gitignored.

# 1. Service account key (ALREADY CREATED — nothing to do)
#    Created with: gcloud iam service-accounts keys create secrets/wallet-sa.json
GOOGLE_APPLICATION_CREDENTIALS=secrets/wallet-sa.json

# 2. GCP project holding the service account (ALREADY CREATED)
GCP_PROJECT_ID=freeticket-wallet-08011232

# 3. Issuer ID — https://pay.google.com/business/console, left nav "Google Wallet API".
#    A ~19-digit NUMBER (starts 33880000...). NOT the Google Pay merchant ID
#    (BCR2DN...) — the API rejects that with "Invalid value at 'issuer_id' (TYPE_INT64)".
#    Then: Users -> Invite a user -> the service account below, role Developer.
GOOGLE_WALLET_ISSUER_ID=

# Google Pay API merchant ID — different product, reference only, unused by wallet_pass.py.
GOOGLE_PAY_MERCHANT_ID=

# 4. Naming — anything URL-safe. Class = the show, Object = one attendee's ticket.
WALLET_CLASS_SUFFIX=freeticket_show
WALLET_ISSUER_NAME=FreeTicket

# 5. Origins allowed to serve the "Add to Google Wallet" button.
#    Comma-separated. Must match exactly, including scheme.
WALLET_ORIGINS=https://appfreeticket.com,https://app.freeticket.us,http://localhost:3000

# ─── Show details (per-event, override at call time) ─────────────────────────
EVENT_NAME=Free Comedy Night
VENUE_NAME=BOOM Stand-Up Bar
# Quoted: an unquoted # starts a comment and would truncate this to "Cl 22".
VENUE_ADDRESS="Cl 22 #5-85, Bogotá, Colombia"
EVENT_START=2026-08-12T20:00:00-05:00
EVENT_END=2026-08-12T22:00:00-05:00
EVENT_HOMEPAGE=https://appfreeticket.com
LOGO_URI=https://appfreeticket.com/brand/apple-icon.png
HERO_URI=
HEX_BACKGROUND_COLOR=#1a1a1a

# Geocode of VENUE_ADDRESS. Apple uses it to surface the pass on the lock screen
# when the attendee arrives — that arrival ping is the attendance signal.
VENUE_LAT=
VENUE_LON=

# ─── Apple Wallet: FreeTicket (apple_pass.py) ────────────────────────────────
# Reuses EVENT_NAME / VENUE_NAME / EVENT_START / EVENT_END / VENUE_* above.

# local  = sign with your own Pass Type ID cert (needs paid Apple Developer Program)
# pass2u = Pass2U signs with theirs (free tier, no Apple account)
APPLE_PASS_PROVIDER=pass2u

# --- provider=local ----------------------------------------------------------
# BLOCKED until you join the Apple Developer Program ($99/yr). A free Apple ID
# personal team (yours is F3V9Y6Y96W) cannot create a Pass Type ID certificate,
# and an "Apple Development" cert will not work as a substitute — iOS checks that
# the cert's UID equals PASS_TYPE_IDENTIFIER and its OU equals TEAM_IDENTIFIER.
PASS_TYPE_IDENTIFIER=pass.us.freeticket.eventticket
TEAM_IDENTIFIER=

# Export from Keychain Access after installing the cert from the dev portal.
APPLE_PASS_P12=secrets/freeticket-pass.p12
APPLE_PASS_P12_PASSWORD=

# Free download, no account: https://www.apple.com/certificateauthority/
APPLE_WWDR_CERT=secrets/AppleWWDRCAG4.cer

# --- provider=pass2u ---------------------------------------------------------
# The only way to get a pass into native Apple Wallet without the $99 program.
# API key: Pass2U account page -> apply for the 30-day free trial key (covers the
# hackathon; extendable for a year if you pay). 32-char base64 string.
#
# Model ID: Dashboard -> Create a Model -> Event Ticket -> issue it -> the ID
# shows on the Issuing tab. In the Model Designer you MUST:
#   - type every field below as "Dynamic" with a matching Key, and
#   - set Barcode Type to "Dynamic - assigned by CSV file or API"
# Fixed / Points / Credits fields cannot be set through the API.
# Field keys apple_pass.py sends: date, event, venue, time, holder, tier, seat,
#                                 points, address, terms
PASS2U_API_KEY=
PASS2U_MODEL_ID=

# --- optional ----------------------------------------------------------------
APPLE_STORE_ID=
# Push updates (e.g. flipping a pass to "used" at the door). Needs live endpoints.
PASS_WEB_SERVICE_URL=
PASS_AUTH_TOKEN=
